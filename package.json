{
  "name": "lake-tech-estates",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @lake-tech/contracts && npm run build --workspace @lake-tech/core && npm run build --workspace @lake-tech/db && npm run build --workspace @lake-tech/web && npm run build --workspace @lake-tech/sl-bot",
    "dev": "npm run dev --workspace @lake-tech/web",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "db:migrate": "npm run migrate --workspace @lake-tech/db",
    "db:seed": "npm run seed --workspace @lake-tech/db",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "overrides": {
    "xmlrpc": "1.3.2",
    "@xmldom/xmldom": "0.9.12",
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "24.10.10",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.5",
    "jsdom": "^30.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vitest": "5.0.0"
  }
}
